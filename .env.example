# =============================================================================
# AWS Authentication
# =============================================================================
# Do NOT store AWS credentials (access keys / secret keys) in this file.
# Instead, use one of the following approaches (in order of preference):
#
# 1. IAM Identity Center (SSO) — recommended for organizations:
#      aws configure sso
#    Then run commands with: AWS_PROFILE=your-sso-profile python main.py ...
#
# 2. Named profiles via the AWS CLI:
#      aws configure --profile nova-sonic-eval
#    Then run commands with: AWS_PROFILE=nova-sonic-eval python main.py ...
#
# 3. Environment variables set in your shell session (ephemeral, not persisted):
#      export AWS_ACCESS_KEY_ID=AKIA...
#      export AWS_SECRET_ACCESS_KEY=...
#      export AWS_SESSION_TOKEN=...  (if using temporary credentials)
#
# All three methods are automatically picked up by boto3 and the AWS SDK.
# See: https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-files.html
# =============================================================================

# AWS region (used as the default for all services unless overridden)
AWS_DEFAULT_REGION=us-east-1

# Nova Sonic Configuration
SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
SONIC_REGION=us-east-1

# Optional: custom endpoint
# SONIC_ENDPOINT_URI=

# Optional: Anthropic API Key (if using Claude API instead of Bedrock)
# ANTHROPIC_API_KEY=your_api_key_here
